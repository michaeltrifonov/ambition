# Copy to .env and fill in. The daemon and agent both load this.

# Inference goes through OpenRouter's Anthropic-compatible endpoint, which keeps
# Claude's native computer-use tool while routing/billing through OpenRouter.
OPENROUTER_API_KEY=sk-or-...
# The driver model. Confirm the exact slug at openrouter.ai/models (only used to seed the
# first config; after that the agent owns it and can hot-swap via request_mutation).
UAA_MODEL=anthropic/claude-opus-4.8
# OpenRouter's Anthropic endpoint (the SDK appends /v1/messages). Rarely changed.
UAA_OPENROUTER_BASE=https://openrouter.ai/api

# Alternative: leave OPENROUTER_API_KEY empty and set this to go direct to Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# Display the computer tool drives. Geometry is AUTO-DETECTED from the live display
# (xdotool); these are only a fallback if detection fails. Keep ≤ 2576px on the long
# edge so screenshots stay 1:1 with model coordinates (no scaling) on Opus 4.6+.
UAA_DISPLAY=:1
UAA_DISPLAY_WIDTH=1280
UAA_DISPLAY_HEIGHT=800

# Surfaced in the agent's system prompt so it knows who to email when it needs a human.
UAA_CREATOR_EMAIL=you@example.com
